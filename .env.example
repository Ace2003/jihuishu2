# 复制本文件为 .env.local，再填写两个服务的真实密钥。不要提交 .env.local。
# 元宝搜索 API Key（KeyName 只是控制台管理名称，不是请求参数）
YUANBAO_API_KEY=

# 兼容 OpenAI Chat Completions 的大模型 API
LLM_API_KEY=
LLM_CHAT_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat

PORT=3000

# 本地仅监听回环地址；公开部署时再由平台设置 HOST。
HOST=127.0.0.1
MAX_CONCURRENT=2
DAILY_INVESTIGATION_LIMIT=30
